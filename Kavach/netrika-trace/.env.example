# Netrika-Trace Environment Configuration

# Redis connection URL for LangGraph state persistence
REDIS_URL=redis://localhost:6379/0

# SQLite database path (relative or absolute)
DATABASE_URL=sqlite:///data/netrika.db

# Ollama host for local Phi-3 LLM (breach simulation)
# Use http://host.docker.internal:11434 when running in Docker
OLLAMA_HOST=http://localhost:11434

# Ollama model name
OLLAMA_MODEL=phi3:mini

# Proxy listening port
PROXY_PORT=8080

# Intervention server port (red-screen pages)
INTERVENTION_PORT=8888

# Dashboard port (Streamlit)
DASHBOARD_PORT=8501

# Admin email for incident review notifications
ADMIN_EMAIL=admin@company.com

# SpaCy model name (use en_core_web_sm for Docker, en_core_web_trf for production)
SPACY_MODEL=en_core_web_sm

# Sentence-transformers model for semantic scoring
SBERT_MODEL=all-MiniLM-L6-v2

# Log level
LOG_LEVEL=INFO

# Gemini API key for LLM Chat (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Configuration for Email Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=razeenpm745@gmail.com
SMTP_PASS=your_app_password_here
SMTP_STARTTLS=true
