{
 "version": 1,
 "rules": [
  {
   "id": "aws_access_key",
   "name": "AWS access key ID",
   "cat": "secret",
   "pattern": "\\b(?:AKIA|ASIA|AGPA|AIDA|AROA|ANPA|ANVA|AIPA)[A-Z0-9]{16}\\b",
   "flags": "",
   "group": 0,
   "conf": 0.98,
   "allow": false
  },
  {
   "id": "aws_secret_key",
   "name": "AWS secret access key",
   "cat": "secret",
   "pattern": "(?:aws|secret|sk)[A-Za-z0-9_\\-. ]{0,24}[\\\"'=:\\s]{1,6}([A-Za-z0-9/+=]{40})\\b",
   "flags": "i",
   "group": 1,
   "conf": 0.9,
   "allow": false,
   "min_ent": 4.0
  },
  {
   "id": "gcp_api_key",
   "name": "Google API key",
   "cat": "secret",
   "pattern": "\\bAIza[0-9A-Za-z_\\-]{35}\\b",
   "flags": "",
   "group": 0,
   "conf": 0.97,
   "allow": false
  },
  {
